# Base de datos (proyecto Supabase de NODO7)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Acceso privado al panel administrador
APP_PIN_HASH=
SESSION_SECRET=

# Códigos y credenciales de demo
DEMO_HASH_SECRET=
DEMO_CREDENTIALS_KEY=

# El proveedor queda desactivado hasta recibir y validar el contrato de la API
DEMO_PROVIDER=disabled
DEMO_PROVIDER_BASE_URL=
DEMO_PROVIDER_API_KEY=

# Entrega de credenciales por WhatsApp
# Con WHATSAPP_PROVIDER=disabled el portal funciona igual que antes:
# el teléfono se pide y se guarda, pero no se valida ni se envía nada.
WHATSAPP_PROVIDER=disabled
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_INSTANCE_ID=
# Número desde el que deben salir los mensajes, en formato internacional.
# Si la instancia queda vinculada a otro teléfono, no se envía nada.
WHATSAPP_EXPECTED_PHONE=
# Texto del mensaje. Marcadores: {credenciales} {vencimiento} {paquete}
WHATSAPP_MESSAGE_TEMPLATE=
# En true las credenciales dejan de mostrarse en pantalla cuando el envío
# funcionó. Mantener en false hasta comprobar que los mensajes llegan.
WHATSAPP_HIDE_CREDENTIALS=false

# Seguimiento: se pregunta cómo le fue, 15 minutos después de que la demo se
# apagó. Marcadores: {nombre} {paquete}. Vacío usa el texto por defecto.
WHATSAPP_FOLLOWUP_FULL=
WHATSAPP_FOLLOWUP_LITE=
# Horas UTC en que NO se escribe. Por defecto 2 a 12 UTC, que es de noche en
# casi toda América. Ajustar al mercado principal.
FOLLOWUP_QUIET_FROM_UTC=2
FOLLOWUP_QUIET_TO_UTC=12

# Tareas programadas en Vercel (limpieza y seguimiento)
CRON_SECRET=
